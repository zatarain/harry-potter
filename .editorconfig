# EditorConfig — https://editorconfig.org
root = true

# Defaults for all files
[*]
charset = utf-8
end_of_line = lf
indent_style = tab
indent_size = 2
tab_width = 2
trim_trailing_whitespace = true
insert_final_newline = true
max_line_length = 100

# Go source — gofmt uses tabs
[*.go]
indent_style = tab
indent_size = 2
tab_width = 2
max_line_length = 120

# Go module and sum files
[go.{mod,sum}]
indent_style = tab
indent_size = 2

# YAML
[*.{yaml,yml}]
indent_style = space
indent_size = 2
tab_width = 2
max_line_length = 120

# JSON
[*.json]
indent_style = space
indent_size = 2
tab_width = 2
max_line_length = off

# TOML
[*.toml]
indent_style = space
indent_size = 2

# Markdown — preserve trailing spaces used for line breaks
[*.md]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false
max_line_length = off

# Shell scripts
[*.{sh,bash,zsh,fish}]
indent_style = space
indent_size = 2
max_line_length = 120

# Makefile — tabs are mandatory
[Makefile]
indent_style = tab
indent_size = 2
tab_width = 2

# INI / config / dotfiles
[*.{ini,cfg,conf}]
indent_style = space
indent_size = 2

# EditorConfig itself
[.editorconfig]
indent_style = space
indent_size = 2

# XML / HTML / SVG
[*.{xml,html,htm,svg}]
indent_style = space
indent_size = 2
max_line_length = 120

# CSS / SCSS / Less
[*.{css,scss,less,sass}]
indent_style = space
indent_size = 2
max_line_length = 100

# TypeScript / JavaScript
[*.{ts,tsx,js,jsx,mjs,cjs}]
indent_style = space
indent_size = 2
max_line_length = 100

# Protocol Buffers
[*.proto]
indent_style = space
indent_size = 2
max_line_length = 100

# Terraform / HCL
[*.{tf,hcl}]
indent_style = space
indent_size = 2

# Git attributes
[.gitattributes]
indent_style = space
indent_size = 2

# GitHub Actions workflows
[.github/**/*.{yaml,yml}]
indent_style = space
indent_size = 2

# Plain-text documents — no forced line length
[{LICENSE,COPYING,NOTICE,CHANGELOG,AUTHORS}]
trim_trailing_whitespace = false
max_line_length = off
